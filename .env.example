# Copy to .env.local and fill in from Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used by API routes (order clicks, events). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Root domain the storefront subdomains hang off (e.g. zaibmobiles.yourbrand.pk).
NEXT_PUBLIC_ROOT_DOMAIN=yourbrand.pk

# Signs dashboard login cookies. Any long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=change-me-to-a-long-random-string
